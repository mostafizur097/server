
# ============================================================
#                         VIDEOX SERVER
#                  PROFESSIONAL ENVIRONMENT
# ============================================================

# -------------------- APPLICATION ----------------------------

APP_NAME=VideoX
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False
TIMEZONE=Asia/Dhaka
LANGUAGE=en

# -------------------- SERVER CONFIGURATION -------------------

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=2
SERVER_RELOAD=False
SERVER_TIMEOUT=120
SERVER_MAX_CONNECTIONS=100

# -------------------- TELEGRAM BOT ---------------------------

TELEGRAM_ENABLED=True
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
CHAT_ID=YOUR_TELEGRAM_CHAT_ID
BOT_MODE=polling
BOT_TIMEOUT=30
BOT_RETRY_LIMIT=3

# -------------------- API CONFIGURATION ----------------------

API_ENABLED=True
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=60
API_TIMEOUT=30

# -------------------- SECURITY -------------------------------

SECRET_KEY=GENERATE_A_STRONG_RANDOM_SECRET
JWT_SECRET_KEY=GENERATE_ANOTHER_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SESSION_SECURE=True
CSRF_ENABLED=True
CORS_ORIGINS=

# -------------------- DATABASE -------------------------------

DATABASE_ENABLED=False
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# -------------------- STORAGE --------------------------------

STORAGE_TYPE=local
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=mp4,mkv,mov,avi,webm

# -------------------- LOGGING --------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILE=videox.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# -------------------- CACHE & PERFORMANCE --------------------

CACHE_ENABLED=True
CACHE_TYPE=memory
CACHE_TTL=300
MAX_REQUESTS_PER_MINUTE=60

# -------------------- NETWORK --------------------------------

HTTP_TIMEOUT=30
CONNECTION_TIMEOUT=15
MAX_RETRIES=3
RETRY_DELAY=2

# -------------------- MONITORING -----------------------------

HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_PATH=/health
METRICS_ENABLED=False

# -------------------- MAINTENANCE ----------------------------

MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=Service temporarily unavailable.

# -------------------- END OF CONFIGURATION -------------------
